{
	"name": "nightpdf",
	"version": "v3.0.0",
	"description": "Dark Mode for PDFs",
	"main": "out/main/app.js",
	"repository": "https://github.com/Lunarequest/NightPDF",
	"homepage": "https://github.com/Lunarequest/NightPDF#readme",
	"bugs": {
		"url": "https://github.com/Lunarequest/NightPDF/issues",
		"email": "nullrequest@vivaldi.net"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"build": "rimraf out && tsx ./build.mts",
		"dev": "npm run typecheck && npm run build && cross-env NODE_ENV=dev electron .",
		"dist": "cross-env NODE_ENV=production NODE_OPTIONS=--max-old-space-size=4096 npm run build && cross-env NODE_ENV=production NODE_OPTIONS=--max-old-space-size=4096 electron-builder --config electron-builder-config.js",
		"lint": "biome check .",
		"format": "biome format . --write",
		"ci": "biome ci .",
		"pre-commit": "npm run ci"
	},
	"author": {
		"name": "Lunarequest",
		"email": "nullrequest@vivaldi.net"
	},
	"license": "GPL-2.0-only",
	"devDependencies": {
		"@biomejs/biome": "^2.4.0",
		"@electron/fuses": "^2.1.0",
		"@types/copy": "^0.3.5",
		"@types/electron-localshortcut": "^3.1.3",
		"@types/figlet": "^1.5.8",
		"@types/node": "^25.0.0",
		"@types/yargs": "^17.0.33",
		"chalk": "^5.3.0",
		"cross-env": "^10.0.0",
		"copy": "^0.3.2",
		"cssnano": "^7.0.5",
		"cssnano-preset-advanced": "^7.0.5",
		"electron": "^41.0.0",
		"electron-builder": "^26.0.0",
		"esbuild": "^0.28.0",
		"esbuild-plugin-glob": "^2.2.3",
		"figlet": "^1.7.0",
		"postcss": "^8.4.41",
		"rimraf": "^6.0.1",
		"sass": "^1.77.8",
		"tsx": "^4.17.0",
		"typescript": "^6.0.0"
	},
	"dependencies": {
		"electron-localshortcut": "^3.2.1",
		"electron-log": "^5.1.7",
		"electron-store": "^8.2.0",
		"electron-tabs": "^1.0.4",
		"electron-updater": "6.3.3",
		"json-schema-typed": "8.0.1",
		"nouislider": "^15.8.1",
		"yargs": "^18.0.0"
	}
}